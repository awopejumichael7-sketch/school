rules_version = '2';

// =============================================================================
// School SaaS - Firestore Security Rules (Spark-only: no Cloud Functions)
//
// Trust model
//  * Nothing the client sends is trusted for identity: tenant membership and
//    role come from /tenants/{t}/members/{uid}, which clients cannot forge
//    (only created in the license-activation batch; admin-created members
//    arrive in Phase 8/9 behind SCHOOL_ADMIN checks).
//  * The tenant is taken from the document PATH, never from a field.
//  * Platform owner = existence of /platformAdmins/{uid} (created by hand in
//    the Firebase console; no client can write it).
//  * Rules allow at most 10 document-access calls per operation and 20 per
//    batch, so helpers are written to use as few get()/exists() as possible.
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- path helpers ----------
    function tenantPath(t)  { return /databases/$(database)/documents/tenants/$(t); }
    function memberPath(t, u) { return /databases/$(database)/documents/tenants/$(t)/members/$(u); }
    function licensePath(h) { return /databases/$(database)/documents/licenses/$(h); }

    // ---------- identity helpers ----------
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    function isPlatformAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // Active member of tenant t (2 access calls: member + tenant). Used for every
    // tenant-scoped data check so a suspended/expired license blocks all access.
    function hasRole(t, roles) {
      let m = get(memberPath(t, request.auth.uid)).data;
      let tn = get(tenantPath(t)).data;
      return signedIn()
        && m.status == 'ACTIVE'
        && m.get('mustChangePassword', false) == false   // temp-password accounts get no data access
        && m.role in roles
        && tn.status == 'ACTIVE'
        && (tn.get('expiresAt', null) == null || tn.expiresAt > request.time);
    }
    function isMember(t) {
      return hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'TEACHER', 'STUDENT', 'PARENT', 'ACCOUNTANT', 'STAFF']);
    }
    // Member of t regardless of license state (used only to let users see "suspended").
    function isMemberAnyState(t) {
      return signedIn() && get(memberPath(t, request.auth.uid)).data.status == 'ACTIVE';
    }
    function isTenantAdminAnyState(t) {
      let m = get(memberPath(t, request.auth.uid)).data;
      return signedIn() && m.status == 'ACTIVE' && m.role == 'SCHOOL_ADMIN';
    }

    // =========================================================================
    // Platform owner
    // =========================================================================
    match /platformAdmins/{id} {
      allow get: if signedIn() && request.auth.uid == id;   // lets the app detect owner mode
      allow list, write: if false;
    }

    // =========================================================================
    // Licenses: document ID = SHA-256 of the key. Possession of the key (80 bits)
    // is required to even address the document, so `get` is open and `list` is not.
    // =========================================================================
    match /licenses/{hash} {
      allow get: if hash.matches('^[0-9a-f]{64}$');
      allow list: if isPlatformAdmin();
      allow create: if isPlatformAdmin() && validNewLicense(hash);
      allow update: if isPlatformAdmin() && ownerLicenseEdit()
                    || isFirstActivation(hash)
                    || isReactivation();
      allow delete: if false;
    }

    function validNewLicense(hash) {
      let d = request.resource.data;
      return hash.matches('^[0-9a-f]{64}$')
        && d.keys().hasOnly(['product', 'plan', 'billingCycle', 'status', 'tenantId', 'installationId',
             'activationCount', 'maxActivations', 'createdAt', 'createdBy', 'activatedAt', 'activatedBy',
             'lastValidated', 'expiresAt', 'note'])
        && d.keys().hasAll(['product', 'plan', 'billingCycle', 'status', 'tenantId', 'installationId',
             'activationCount', 'maxActivations', 'createdAt', 'createdBy', 'activatedAt', 'activatedBy',
             'lastValidated', 'expiresAt', 'note'])
        && d.status == 'UNUSED'
        && d.tenantId == null
        && d.installationId == null
        && d.activationCount == 0
        && d.maxActivations is int && d.maxActivations >= 1 && d.maxActivations <= 5
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && d.plan is string && d.plan.size() <= 40
        && d.billingCycle in ['LIFETIME', 'MONTHLY', 'QUARTERLY', 'ANNUAL']
        && (d.expiresAt == null || d.expiresAt is timestamp)
        && d.note is string && d.note.size() <= 300;
    }

    // Product owner may change anything EXCEPT the tenant binding once it exists,
    // so a key can never be re-pointed to a different school.
    function ownerLicenseEdit() {
      return request.resource.data.status in ['UNUSED', 'ACTIVE', 'DEACTIVATED', 'RESET']
        && (resource.data.tenantId == null || request.resource.data.tenantId == resource.data.tenantId)
        && request.resource.data.keys().hasOnly(['product', 'plan', 'billingCycle', 'status', 'tenantId',
             'installationId', 'activationCount', 'maxActivations', 'createdAt', 'createdBy', 'activatedAt',
             'activatedBy', 'lastValidated', 'expiresAt', 'note'])
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    // First activation: UNUSED -> ACTIVE, bound to the tenant created in the SAME batch.
    // Access calls: 2 (exists tenant before, getAfter tenant).
    function isFirstActivation(hash) {
      let before = resource.data;
      let after = request.resource.data;
      return signedIn()
        && before.status == 'UNUSED'
        && before.tenantId == null
        && before.activationCount < before.maxActivations
        && (before.get('expiresAt', null) == null || before.expiresAt > request.time)
        && after.diff(before).affectedKeys().hasOnly(
             ['status', 'tenantId', 'activatedAt', 'activatedBy', 'installationId', 'activationCount', 'lastValidated'])
        && after.status == 'ACTIVE'
        && after.activationCount == before.activationCount + 1
        && after.activatedBy == request.auth.uid
        && after.activatedAt == request.time
        && after.lastValidated == request.time
        && after.tenantId is string
        && after.installationId is string && after.installationId.size() >= 8
        && !exists(tenantPath(after.tenantId))
        && getAfter(tenantPath(after.tenantId)).data.licenseId == hash
        && getAfter(tenantPath(after.tenantId)).data.ownerUid == request.auth.uid;
        // (the tenant's own create rule independently verifies the license state)
    }

    // Re-binding after the product owner reset the installation. The tenant can
    // NOT change (tenantId is not in affectedKeys), and the caller must be an
    // admin of that same tenant.
    function isReactivation() {
      let before = resource.data;
      let after = request.resource.data;
      return signedIn()
        && before.status == 'RESET'
        && before.tenantId is string
        && before.activationCount < before.maxActivations
        && (before.get('expiresAt', null) == null || before.expiresAt > request.time)
        && after.diff(before).affectedKeys().hasOnly(['status', 'installationId', 'activationCount', 'lastValidated'])
        && after.status == 'ACTIVE'
        && after.activationCount == before.activationCount + 1
        && after.lastValidated == request.time
        && after.installationId is string && after.installationId.size() >= 8
        && isTenantAdminAnyState(before.tenantId);
    }

    match /licenseEvents/{id} {
      allow read: if isPlatformAdmin();
      allow create: if validLicenseEvent();
      allow update, delete: if false;
    }
    function validLicenseEvent() {
      let d = request.resource.data;
      return signedIn()
        && d.actorId == request.auth.uid
        && d.at == request.time
        && d.licenseId is string && d.licenseId.matches('^[0-9a-f]{64}$')
        && d.keys().hasOnly(['licenseId', 'tenantId', 'type', 'actorId', 'at', 'metadata'])
        && (isPlatformAdmin()
            || (d.type in ['ACTIVATED', 'REACTIVATED']
                && getAfter(licensePath(d.licenseId)).data.tenantId == d.tenantId
                && getAfter(licensePath(d.licenseId)).data.status == 'ACTIVE'));
    }

    // =========================================================================
    // Public, non-sensitive school pages (login branding)
    // =========================================================================
    match /slugs/{slug} {
      allow get: if true;
      allow list, update, delete: if false;
      // Only creatable while the tenant itself is being created in this batch.
      allow create: if signedIn()
        && slug.matches('^[a-z0-9][a-z0-9-]{2,39}$')
        && request.resource.data.keys().hasOnly(['tenantId'])
        && request.resource.data.tenantId is string
        && !exists(tenantPath(request.resource.data.tenantId))
        && getAfter(tenantPath(request.resource.data.tenantId)).data.ownerUid == request.auth.uid;
    }

    match /publicProfiles/{t} {
      allow get: if true;
      allow list: if isPlatformAdmin();
      allow create: if signedIn()
        && validPublicProfile(t)
        && getAfter(tenantPath(t)).data.ownerUid == request.auth.uid;   // ownerUid is immutable
      allow update: if hasRole(t, ['SCHOOL_ADMIN'])
        && validPublicProfile(t)
        && request.resource.data.slug == resource.data.slug;
      allow delete: if false;
    }
    function validPublicProfile(t) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tenantId', 'slug', 'name', 'motto', 'logoDataUrl', 'primaryColor', 'secondaryColor'])
        && d.tenantId == t
        && d.slug is string && d.slug.matches('^[a-z0-9][a-z0-9-]{2,39}$')
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
        && d.motto is string && d.motto.size() <= 200
        && (d.logoDataUrl == null
            || (d.logoDataUrl is string && d.logoDataUrl.size() <= 70000
                && d.logoDataUrl.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$')))
        && d.primaryColor.matches('^#[0-9a-fA-F]{6}$')
        && d.secondaryColor.matches('^#[0-9a-fA-F]{6}$');
    }

    // Pointer used by the client to find "which tenant am I in". It grants nothing:
    // every real access check goes through members/{uid} under the tenant path.
    match /userDirectory/{u} {
      allow get: if signedIn() && request.auth.uid == u;
      // Self (first admin, in the activation batch) or a school admin placing a NEW user into
      // THEIR OWN school. Create-only: a user already placed in another school cannot be moved.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['tenantId'])
        && request.resource.data.tenantId is string
        && existsAfter(memberPath(request.resource.data.tenantId, u))
        && (request.auth.uid == u || hasRole(request.resource.data.tenantId, ['SCHOOL_ADMIN']));
      allow list, update, delete: if false;
    }

    // =========================================================================
    // Tenants
    // =========================================================================
    match /tenants/{t} {
      allow get: if isPlatformAdmin() || isMemberAnyState(t);
      allow list: if isPlatformAdmin();
      allow create: if validTenantCreate(t);
      // Order matters: branches that can raise an error for the caller (member lookups)
      // come last, so a product owner (who has no member doc) never depends on error handling.
      allow update: if (isPlatformAdmin() && platformTenantEdit())
                    || tenantReactivation(t)
                    || (hasRole(t, ['SCHOOL_ADMIN']) && tenantSettingsEdit());
      allow delete: if false;
    }

    function validTenantCreate(t) {
      let d = request.resource.data;
      let lb = get(licensePath(d.licenseId)).data;
      let la = getAfter(licensePath(d.licenseId)).data;
      return signedIn()
        && d.keys().hasOnly(['name', 'ownerUid', 'licenseId', 'plan', 'status', 'installationId', 'expiresAt',
             'profile', 'settings', 'setupComplete', 'createdAt'])
        && d.ownerUid == request.auth.uid
        && d.status == 'ACTIVE'
        && d.setupComplete == false
        && d.createdAt == request.time
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 120
        && lb.status == 'UNUSED'
        && la.status == 'ACTIVE'
        && la.tenantId == t
        && la.activatedBy == request.auth.uid
        && la.installationId == d.installationId
        && d.plan == lb.plan
        && d.get('expiresAt', null) == lb.get('expiresAt', null);
    }

    // School admins may edit presentation/config only; never owner, license, status, plan, expiry.
    function tenantSettingsEdit() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'profile', 'settings', 'setupComplete', 'updatedAt']);
    }
    // Product owner may only change commercial/status fields; never school data.
    function platformTenantEdit() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'expiresAt', 'plan', 'updatedAt'])
        && request.resource.data.status in ['ACTIVE', 'SUSPENDED'];
    }
    // After an owner "reset installation": the school admin proves possession of the
    // key by re-activating the license, and the tenant is switched back on.
    function tenantReactivation(t) {
      let la = getAfter(licensePath(resource.data.licenseId)).data;
      return isTenantAdminAnyState(t)
        && resource.data.status == 'SUSPENDED'
        && request.resource.data.status == 'ACTIVE'
        && get(licensePath(resource.data.licenseId)).data.status == 'RESET'
        && la.status == 'ACTIVE'
        && la.tenantId == t
        && request.resource.data.installationId == la.installationId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'installationId', 'updatedAt']);
    }

    // ---------- members ----------
    match /tenants/{t}/members/{m} {
      allow get: if signedIn() && request.auth.uid == m;
      allow list: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL']);
      allow create: if ownerBootstrapMember(t, m) || adminCreatesMember(t, m);
      allow update: if selfClearsPasswordFlag(m) || adminUpdatesMember(t, m);
      allow delete: if false;
    }

    // The tenant owner (license activator) creates their own admin membership.
    function ownerBootstrapMember(t, m) {
      return signedIn()
        && request.auth.uid == m
        && getAfter(tenantPath(t)).data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'tenantId', 'role', 'status', 'displayName', 'email'])
        && request.resource.data.uid == m
        && request.resource.data.tenantId == t
        && request.resource.data.role == 'SCHOOL_ADMIN'
        && request.resource.data.status == 'ACTIVE';
    }

    // A school admin creates staff/student/parent members. They start with mustChangePassword = true.
    function adminCreatesMember(t, m) {
      let d = request.resource.data;
      return hasRole(t, ['SCHOOL_ADMIN'])
        && request.auth.uid != m
        && d.keys().hasOnly(['uid', 'tenantId', 'role', 'status', 'displayName', 'email', 'loginId',
             'mustChangePassword', 'classIds', 'subjectIds'])
        && d.keys().hasAll(['uid', 'tenantId', 'role', 'status', 'displayName', 'email', 'loginId', 'mustChangePassword'])
        && d.uid == m
        && d.tenantId == t
        && d.role in ['SCHOOL_ADMIN', 'PRINCIPAL', 'TEACHER', 'STUDENT', 'PARENT', 'ACCOUNTANT', 'STAFF']
        && d.status == 'ACTIVE'
        && d.mustChangePassword == true
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 120
        && d.email is string && d.email.size() <= 200
        && d.loginId is string && d.loginId.size() >= 1 && d.loginId.size() <= 200
        && (!('classIds' in d) || (d.classIds is list && d.classIds.size() <= 60))
        && (!('subjectIds' in d) || (d.subjectIds is list && d.subjectIds.size() <= 60));
    }

    // The user replaced their temporary password; they may only flip this one flag, true -> false.
    function selfClearsPasswordFlag(m) {
      return signedIn()
        && request.auth.uid == m
        && resource.data.get('mustChangePassword', false) == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword'])
        && request.resource.data.mustChangePassword == false;
    }

    // Admins manage OTHER members (never themselves, so a school can't lock itself out by accident).
    function adminUpdatesMember(t, m) {
      let d = request.resource.data;
      return hasRole(t, ['SCHOOL_ADMIN'])
        && request.auth.uid != m
        && d.diff(resource.data).affectedKeys().hasOnly(['status', 'role', 'displayName', 'classIds', 'subjectIds'])
        && d.status in ['ACTIVE', 'DISABLED']
        && d.role in ['SCHOOL_ADMIN', 'PRINCIPAL', 'TEACHER', 'STUDENT', 'PARENT', 'ACCOUNTANT', 'STAFF']
        && d.displayName is string && d.displayName.size() >= 1 && d.displayName.size() <= 120
        && (!('classIds' in d) || (d.classIds is list && d.classIds.size() <= 60))
        && (!('subjectIds' in d) || (d.subjectIds is list && d.subjectIds.size() <= 60));
    }

    // ---------- school configuration collections ----------
    match /tenants/{t}/classes/{id} {
      allow read: if isMember(t);
      allow create: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL']) && validNamed(t);
      allow update: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL']) && validNamed(t)
                    && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if hasRole(t, ['SCHOOL_ADMIN']);
    }
    match /tenants/{t}/subjects/{id} {
      allow read: if isMember(t);
      allow create: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL']) && validNamed(t);
      allow update: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL']) && validNamed(t)
                    && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if hasRole(t, ['SCHOOL_ADMIN']);
    }
    match /tenants/{t}/terms/{id} {
      allow read: if isMember(t);
      allow create: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL']) && validNamed(t);
      allow update: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL']) && validNamed(t)
                    && request.resource.data.tenantId == resource.data.tenantId;
      allow delete: if hasRole(t, ['SCHOOL_ADMIN']);
    }
    function validNamed(t) {
      return request.resource.data.tenantId == t
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 100;
    }

    // ---------- shared validators ----------
    // Photos/logos are small inline images (Spark has no Cloud Storage).
    function validPhoto(p) {
      return p == null
        || (p is string && p.size() <= 30000
            && p.matches('^data:image/(png|jpeg|webp);base64,[A-Za-z0-9+/=]+$'));
    }
    function isoDate(v) {
      return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    // ---------- teachers ----------
    match /tenants/{t}/teachers/{id} {
      allow get: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'STAFF'])
                 || (hasRole(t, ['TEACHER']) && request.auth.uid == id);
      allow list: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'STAFF']);
      allow create: if hasRole(t, ['SCHOOL_ADMIN']) && validTeacherCreate(t, id);
      allow update: if hasRole(t, ['SCHOOL_ADMIN']) && validTeacherUpdate();
      allow delete: if false;   // deactivate instead
    }
    function validTeacherShape(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 120
        && d.phone is string && d.phone.size() <= 20
        && d.email is string && d.email.size() <= 200
        && d.subjects is list && d.subjects.size() <= 60
        && d.classes is list && d.classes.size() <= 60
        && d.status in ['ACTIVE', 'INACTIVE']
        && validPhoto(d.photo);
    }
    function validTeacherCreate(t, id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tenantId', 'teacherId', 'uid', 'name', 'photo', 'phone', 'email', 'loginId',
               'subjects', 'classes', 'status', 'createdAt', 'createdBy'])
        && d.keys().hasAll(['tenantId', 'teacherId', 'uid', 'name', 'photo', 'phone', 'email', 'loginId',
               'subjects', 'classes', 'status', 'createdAt', 'createdBy'])
        && d.tenantId == t
        && d.uid == id
        && d.teacherId is string && d.teacherId.size() <= 40
        && d.loginId is string && d.loginId.size() <= 200
        && d.status == 'ACTIVE'
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && validTeacherShape(d);
    }
    function validTeacherUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'photo', 'phone', 'email', 'subjects', 'classes', 'status', 'updatedAt'])
        && validTeacherShape(request.resource.data);
    }

    // ---------- students (document ID = admission number, so it is unique per school) ----------
    match /tenants/{t}/students/{id} {
      allow read: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'ACCOUNTANT', 'STAFF'])
                  || (hasRole(t, ['TEACHER'])
                      && resource.data.classId in get(memberPath(t, request.auth.uid)).data.get('classIds', []))
                  || (hasRole(t, ['PARENT']) && request.auth.uid in resource.data.parentIds)
                  || (hasRole(t, ['STUDENT']) && resource.data.get('uid', null) == request.auth.uid);
      allow create: if hasRole(t, ['SCHOOL_ADMIN']) && validStudentCreate(t, id);
      allow update: if hasRole(t, ['SCHOOL_ADMIN']) && validStudentUpdate();
      allow delete: if false;   // deactivate instead
    }
    function validStudentShape(d) {
      return d.firstName is string && d.firstName.size() >= 1 && d.firstName.size() <= 60
        && d.middleName is string && d.middleName.size() <= 60
        && d.lastName is string && d.lastName.size() >= 1 && d.lastName.size() <= 60
        && d.gender in ['MALE', 'FEMALE']
        && isoDate(d.dateOfBirth)
        && isoDate(d.admissionDate)
        && d.classId is string && d.classId.size() >= 1 && d.classId.size() <= 100
        && d.parentIds is list && d.parentIds.size() <= 6
        && d.phone is string && d.phone.size() <= 20
        && d.email is string && d.email.size() <= 200
        && d.address is string && d.address.size() <= 300
        && d.status in ['ACTIVE', 'INACTIVE', 'GRADUATED', 'TRANSFERRED']
        && d.academicSession is string && d.academicSession.size() <= 40
        && (d.uid == null || d.uid is string)
        && validPhoto(d.photo);
    }
    function validStudentCreate(t, id) {
      let d = request.resource.data;
      return id.matches('^[A-Za-z0-9-]{3,30}$')
        && d.keys().hasOnly(['tenantId', 'studentId', 'admissionNumber', 'firstName', 'middleName', 'lastName',
               'gender', 'dateOfBirth', 'photo', 'classId', 'parentIds', 'phone', 'email', 'address',
               'admissionDate', 'status', 'academicSession', 'uid', 'createdAt', 'createdBy'])
        && d.keys().hasAll(['tenantId', 'studentId', 'admissionNumber', 'firstName', 'middleName', 'lastName',
               'gender', 'dateOfBirth', 'photo', 'classId', 'parentIds', 'phone', 'email', 'address',
               'admissionDate', 'status', 'academicSession', 'uid', 'createdAt', 'createdBy'])
        && d.tenantId == t
        && d.studentId == id
        && d.admissionNumber == id
        && d.parentIds.size() == 0
        && d.status == 'ACTIVE'
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && validStudentShape(d);
    }
    function validStudentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['firstName', 'middleName', 'lastName', 'gender', 'dateOfBirth', 'photo', 'classId',
                         'parentIds', 'phone', 'email', 'address', 'admissionDate', 'status',
                         'academicSession', 'uid', 'updatedAt'])
        && validStudentShape(request.resource.data);
    }

    // ---------- parents ----------
    match /tenants/{t}/parents/{id} {
      allow get: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'STAFF'])
                 || (hasRole(t, ['PARENT']) && request.auth.uid == id);
      allow list: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'STAFF']);
      allow create: if hasRole(t, ['SCHOOL_ADMIN']) && validParentCreate(t, id);
      allow update: if hasRole(t, ['SCHOOL_ADMIN']) && validParentUpdate();
      allow delete: if false;
    }
    function validParentShape(d) {
      return d.name is string && d.name.size() >= 2 && d.name.size() <= 120
        && d.phone is string && d.phone.size() <= 20
        && d.email is string && d.email.size() <= 200
        && d.childIds is list && d.childIds.size() <= 20
        && d.status in ['ACTIVE', 'INACTIVE'];
    }
    function validParentCreate(t, id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tenantId', 'uid', 'name', 'phone', 'email', 'loginId', 'childIds', 'status',
               'createdAt', 'createdBy'])
        && d.keys().hasAll(['tenantId', 'uid', 'name', 'phone', 'email', 'loginId', 'childIds', 'status',
               'createdAt', 'createdBy'])
        && d.tenantId == t
        && d.uid == id
        && d.loginId is string && d.loginId.size() <= 200
        && d.status == 'ACTIVE'
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && validParentShape(d);
    }
    function validParentUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'phone', 'email', 'childIds', 'status', 'updatedAt'])
        && validParentShape(request.resource.data);
    }

    // ---------- counters (admission numbers; receipt numbers) ----------
    function counterWriter(t, name) {
      return hasRole(t, ['SCHOOL_ADMIN'])
        || (name.matches('^receipts-[0-9]{4}$') && hasRole(t, ['ACCOUNTANT']));
    }
    match /tenants/{t}/counters/{name} {
      allow read: if counterWriter(t, name);
      allow create: if counterWriter(t, name)
        && name.matches('^[a-z0-9-]{1,40}$')
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next >= 1 && request.resource.data.next <= 1000000;
      // Only ever moves forward, by a bounded amount (no resetting to reuse numbers).
      allow update: if counterWriter(t, name)
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next > resource.data.next
        && request.resource.data.next <= resource.data.next + 501;
      allow delete: if false;
    }

    // ---------- attendance: ONE document per class per day (cheap on the free quota) ----------
    // Parents/students get a privacy-safe view in a later phase; this document lists a whole class.
    function canRecordAttendance(t, classId) {
      return hasRole(t, ['SCHOOL_ADMIN'])
        || (hasRole(t, ['TEACHER']) && classId in get(memberPath(t, request.auth.uid)).data.get('classIds', []));
    }
    match /tenants/{t}/attendance/{id} {
      allow read: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'STAFF'])
                  || (hasRole(t, ['TEACHER'])
                      && resource.data.classId in get(memberPath(t, request.auth.uid)).data.get('classIds', []));
      allow create: if canRecordAttendance(t, request.resource.data.classId) && validAttendanceCreate(t, id);
      allow update: if canRecordAttendance(t, resource.data.classId) && validAttendanceUpdate();
      allow delete: if false;
    }
    function validAttendanceShape(d) {
      return d.records is map && d.records.size() <= 300
        && d.records.values().hasOnly(['P', 'A', 'L', 'E'])
        && d.names is map && d.names.size() <= 300
        && d.counts is map
        && d.counts.keys().hasOnly(['P', 'A', 'L', 'E'])
        && d.counts.keys().hasAll(['P', 'A', 'L', 'E'])
        && d.counts.P is int && d.counts.A is int && d.counts.L is int && d.counts.E is int
        && d.counts.P >= 0 && d.counts.A >= 0 && d.counts.L >= 0 && d.counts.E >= 0
        && d.total is int
        && d.total == d.records.size()
        && d.counts.P + d.counts.A + d.counts.L + d.counts.E == d.total;
    }
    function validAttendanceCreate(t, id) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tenantId', 'classId', 'date', 'month', 'session', 'records', 'names', 'counts',
               'total', 'takenBy', 'takenByName', 'createdAt'])
        && d.keys().hasAll(['tenantId', 'classId', 'date', 'month', 'session', 'records', 'names', 'counts',
               'total', 'takenBy', 'takenByName', 'createdAt'])
        && d.tenantId == t
        && d.classId is string && d.classId.size() >= 1 && d.classId.size() <= 100
        && isoDate(d.date)
        && d.month == d.date.split('-')[0] + '-' + d.date.split('-')[1]
        && id == d.classId + '_' + d.date
        && d.session is string && d.session.size() <= 40
        && d.takenBy == request.auth.uid
        && d.takenByName is string && d.takenByName.size() <= 120
        && d.createdAt == request.time
        && validAttendanceShape(d);
    }
    function validAttendanceUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['records', 'names', 'counts', 'total', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && validAttendanceShape(request.resource.data);
    }

    // ---------- fees (money is integer minor units: kobo/cents) ----------
    function feePath(t, f) { return /databases/$(database)/documents/tenants/$(t)/fees/$(f); }
    function paymentPath(t, p) { return /databases/$(database)/documents/tenants/$(t)/payments/$(p); }
    function validFeeCategory(c) { return c in ['TUITION', 'BOOKS', 'UNIFORM', 'TRANSPORT', 'EXAMINATION', 'OTHER']; }

    match /tenants/{t}/feeItems/{id} {
      allow read: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'ACCOUNTANT']);
      allow create: if hasRole(t, ['SCHOOL_ADMIN', 'ACCOUNTANT']) && validFeeItemCreate(t);
      allow update: if hasRole(t, ['SCHOOL_ADMIN', 'ACCOUNTANT']) && validFeeItemUpdate();
      allow delete: if false;   // archive instead
    }
    function validFeeItemShape(d) {
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 100
        && validFeeCategory(d.category)
        && d.amount is int && d.amount > 0 && d.amount <= 100000000000
        && d.classIds is list && d.classIds.size() >= 1 && d.classIds.size() <= 60
        && d.termId is string && d.termId.size() <= 100
        && d.session is string && d.session.size() >= 1 && d.session.size() <= 40
        && d.status in ['ACTIVE', 'ARCHIVED'];
    }
    function validFeeItemCreate(t) {
      let d = request.resource.data;
      return d.keys().hasOnly(['tenantId', 'name', 'category', 'amount', 'classIds', 'termId', 'session', 'status',
               'createdAt', 'createdBy'])
        && d.keys().hasAll(['tenantId', 'name', 'category', 'amount', 'classIds', 'termId', 'session', 'status',
               'createdAt', 'createdBy'])
        && d.tenantId == t
        && d.status == 'ACTIVE'
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid
        && validFeeItemShape(d);
    }
    function validFeeItemUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['name', 'category', 'amount', 'classIds', 'termId', 'status', 'updatedAt'])
        && validFeeItemShape(request.resource.data);
    }

    match /tenants/{t}/fees/{id} {
      allow read: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'ACCOUNTANT']);
      allow create: if hasRole(t, ['SCHOOL_ADMIN', 'ACCOUNTANT']) && validFeeCreate(t, id);
      allow update: if hasRole(t, ['SCHOOL_ADMIN', 'ACCOUNTANT']) && validFeeUpdate();
      allow delete: if false;
    }
    // A new fee is always unpaid with balance == amount.
    function validFeeCreate(t, id) {
      let d = request.resource.data;
      return id.matches('^[A-Za-z0-9_-]{1,160}$')
        && d.keys().hasOnly(['tenantId', 'studentId', 'studentName', 'classId', 'itemId', 'description', 'category',
               'amount', 'amountPaid', 'balance', 'status', 'session', 'termId', 'dueDate', 'createdAt', 'createdBy'])
        && d.keys().hasAll(['tenantId', 'studentId', 'studentName', 'classId', 'itemId', 'description', 'category',
               'amount', 'amountPaid', 'balance', 'status', 'session', 'termId', 'dueDate', 'createdAt', 'createdBy'])
        && d.tenantId == t
        && d.studentId is string && d.studentId.size() >= 1 && d.studentId.size() <= 60
        && d.studentName is string && d.studentName.size() <= 120
        && d.classId is string && d.classId.size() <= 100
        && (d.itemId == null || d.itemId is string)
        && d.description is string && d.description.size() >= 1 && d.description.size() <= 100
        && validFeeCategory(d.category)
        && d.amount is int && d.amount > 0 && d.amount <= 100000000000
        && d.amountPaid == 0
        && d.balance == d.amount
        && d.status == 'UNPAID'
        && d.session is string && d.session.size() <= 40
        && d.termId is string && d.termId.size() <= 100
        && d.dueDate is string && (d.dueDate == '' || isoDate(d.dueDate))
        && d.createdAt == request.time
        && d.createdBy == request.auth.uid;
    }
    // The ONLY changes allowed to an existing fee keep the books consistent:
    // balance == amount - amountPaid, 0 <= amountPaid <= amount, status derived from them (or CANCELLED when unpaid).
    function validFeeUpdate() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(['amountPaid', 'balance', 'status', 'updatedAt'])
        && d.amountPaid is int && d.amountPaid >= 0 && d.amountPaid <= d.amount
        && d.balance == d.amount - d.amountPaid
        && d.status in ['UNPAID', 'PARTIAL', 'PAID', 'CANCELLED']
        && (d.status == 'CANCELLED'
            ? d.amountPaid == 0
            : d.status == (d.amountPaid == 0 ? 'UNPAID' : (d.balance == 0 ? 'PAID' : 'PARTIAL')));
    }

    // Payments are append-only. A mistake is corrected by a REVERSAL record, never by editing or deleting.
    match /tenants/{t}/payments/{id} {
      allow read: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'ACCOUNTANT']);
      allow create: if hasRole(t, ['SCHOOL_ADMIN', 'ACCOUNTANT']) && validPaymentCreate(t, id);
      allow update: if hasRole(t, ['SCHOOL_ADMIN', 'ACCOUNTANT']) && validPaymentReversedFlag(t, id);
      allow delete: if false;
    }
    // The payment must move the fee's amountPaid by EXACTLY its amount, in the same batch (getAfter).
    function validPaymentCreate(t, id) {
      let d = request.resource.data;
      let fb = get(feePath(t, d.feeId)).data;
      let fa = getAfter(feePath(t, d.feeId)).data;
      return d.keys().hasOnly(['tenantId', 'feeId', 'studentId', 'studentName', 'classId', 'description', 'amount',
               'balanceAfter', 'kind', 'method', 'reference', 'note', 'paymentDate', 'receiptNumber', 'reverses',
               'reversed', 'reversedBy', 'recordedBy', 'recordedByName', 'recordedAt'])
        && d.keys().hasAll(['tenantId', 'feeId', 'studentId', 'studentName', 'classId', 'description', 'amount',
               'balanceAfter', 'kind', 'method', 'reference', 'note', 'paymentDate', 'receiptNumber', 'reverses',
               'reversed', 'reversedBy', 'recordedBy', 'recordedByName', 'recordedAt'])
        && id.matches('^(RCPT|REV)-[0-9]{4}-[0-9]{6,}$')
        && d.receiptNumber == id
        && d.tenantId == t
        && d.studentId == fb.studentId
        && fb.status != 'CANCELLED'
        && d.amount is int && d.amount > 0 && d.amount <= 100000000000
        && d.balanceAfter is int && d.balanceAfter == fa.balance
        && d.method in ['CASH', 'BANK_TRANSFER', 'POS', 'CHEQUE', 'OTHER']
        && d.reference is string && d.reference.size() <= 100
        && d.note is string && d.note.size() <= 200
        && isoDate(d.paymentDate)
        && d.studentName is string && d.studentName.size() <= 120
        && d.classId is string && d.classId.size() <= 100
        && d.description is string && d.description.size() <= 100
        && d.reversed == false
        && d.reversedBy == null
        && d.recordedBy == request.auth.uid
        && d.recordedByName is string && d.recordedByName.size() <= 120
        && d.recordedAt == request.time
        && ((d.kind == 'PAYMENT'
              && d.reverses == null
              && id.matches('^RCPT-.*')
              && fa.amountPaid == fb.amountPaid + d.amount)
            || (d.kind == 'REVERSAL'
              && d.reverses is string
              && id.matches('^REV-.*')
              && fa.amountPaid == fb.amountPaid - d.amount
              && get(paymentPath(t, d.reverses)).data.amount == d.amount
              && get(paymentPath(t, d.reverses)).data.feeId == d.feeId
              && get(paymentPath(t, d.reverses)).data.kind == 'PAYMENT'
              && get(paymentPath(t, d.reverses)).data.reversed == false));
    }
    // The only change ever allowed to a payment: flag it reversed, pointing at the reversal written in the same batch.
    function validPaymentReversedFlag(t, id) {
      let d = request.resource.data;
      return resource.data.kind == 'PAYMENT'
        && resource.data.reversed == false
        && d.diff(resource.data).affectedKeys().hasOnly(['reversed', 'reversedBy'])
        && d.reversed == true
        && d.reversedBy is string
        && getAfter(paymentPath(t, d.reversedBy)).data.reverses == id;
    }

    // ---------- audit log: append-only, actor must be the caller ----------
    match /tenants/{t}/auditLogs/{id} {
      allow read: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL']);
      allow create: if hasRole(t, ['SCHOOL_ADMIN', 'PRINCIPAL', 'TEACHER', 'ACCOUNTANT', 'STAFF'])
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.tenantId == t
        && request.resource.data.timestamp == request.time
        && request.resource.data.keys().hasOnly(['actorId', 'tenantId', 'action', 'target', 'timestamp', 'metadata']);
      allow update, delete: if false;
    }

    // Everything else is denied until its phase adds explicit, tested rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
