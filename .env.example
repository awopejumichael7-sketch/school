# Copy to .env and fill in from Firebase Console > Project settings > Your apps (Web).
# These values are PUBLIC identifiers, not secrets. Security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional: reCAPTCHA v3 site key for Firebase App Check (strongly recommended, free).
VITE_APPCHECK_SITE_KEY=
